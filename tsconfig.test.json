{
  // Tests are excluded from the build but still need type checking; they are
  // the main consumer of the public API and catch drift in its shape.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
